GOOGLE_CLOUD_PROJECT=your-project-id
CLOUD_RUN_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Code-fix track — required when testing the GitHub PR flow locally
GITHUB_REPO_URL=https://github.com/org/repo
GITHUB_TOKEN=ghp_xxxx
GIT_AUTHOR_NAME=DinoAgent
GIT_AUTHOR_EMAIL=dinoagent@noreply.github.com

# Slack notifications — set one of these
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
# SLACK_WEBHOOK_SECRET=projects/my-project/secrets/slack-webhook/versions/latest

# Local testing only — simulates the Pub/Sub payload from Eventarc.
# Swap in one of the example messages from the README to test a specific track.
ERROR_MESSAGE=Service my-api is failing: container exited with code 1
